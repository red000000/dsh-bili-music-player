{
  "name": "dsh-bili-music-player",
  "version": "0.2.1",
  "type": "module",
  "description": "B 站音乐点歌助手：按画像推荐、软反馈、在线兜底，附带播放条与音频缓存代理",
  "license": "AGPL-3.0-only",
  "author": "RED",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "bilibili",
    "music",
    "player",
    "recommendation"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "src/**/*.js",
    "client.js",
    "client/**/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/adr/*.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/red000000/dsh-bili-music-player.git"
  },
  "homepage": "https://github.com/red000000/dsh-bili-music-player#readme",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "scripts": {
    "build": "esbuild client/index.js --bundle --format=iife --platform=browser --target=chrome110 --legal-comments=none --outfile=client.js",
    "test": "node --test --test-isolation=none \"tests/**/*.test.mjs\"",
    "format": "prettier --write src client index.js tests eslint.config.js .prettierrc.json package.json",
    "lint": "eslint ."
  }
}
